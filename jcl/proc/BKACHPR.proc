//BKACHPR  PROC WINDOW=NIGHT,CYCLE=0
//* ACH inbound PROC. Symbolic WINDOW/CYCLE.
//* RC contract 0/4/8/12/16. Existence check before COBOL.
//STEPCHK  EXEC PGM=IEFBR14
//UACHIN   DD   DSN=HUB.ACH.NACHA.D&CYCLE,DISP=SHR
//STEPLST  EXEC PGM=IDCAMS
//SYSPRINT DD   SYSOUT=*
//SYSIN    DD   *
  LISTCAT ENTRIES(HUB.ACH.NACHA.D&CYCLE)
  IF LASTCC > 0 THEN SET MAXCC = 8
/*
//STEPACH  EXEC PGM=BKACH01,COND=(8,LE,STEPLST)
//STEPLIB  DD   DSN=HUB.LOAD,DISP=SHR
//UACHIN   DD   DSN=HUB.ACH.NACHA.D&CYCLE,DISP=SHR
//SYSIN    DD   *
&WINDOW
/*
//SYSOUT   DD   SYSOUT=*
//         PEND
