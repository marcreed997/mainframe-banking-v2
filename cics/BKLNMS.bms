BKLNMS    DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,
               STORAGE=AUTO,TIOAPFX=YES,CTRL=(FREEKB,FRSET)
BKLNMSS   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
TTL      DFHMDF POS=(01,01),LENGTH=08,ATTRB=(ASKIP,BRT),
               INITIAL='BKLNMS'
TTL2     DFHMDF POS=(01,34),LENGTH=12,
               ATTRB=(ASKIP,BRT),INITIAL='LOAN PAYMENT'
LINE2    DFHMDF POS=(02,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='------------------------------------------------------------------------------'
LBLNT    DFHMDF POS=(04,02),LENGTH=12,ATTRB=ASKIP,INITIAL='NOTE NO.....'
NOTE     DFHMDF POS=(04,16),LENGTH=10,ATTRB=(UNPROT,IC,FSET)
S13A     DFHMDF POS=(04,27),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLACC   DFHMDF POS=(05,02),LENGTH=12,ATTRB=ASKIP,INITIAL='DDA FUNDING.'
ACCNO    DFHMDF POS=(05,16),LENGTH=06,ATTRB=(UNPROT,FSET)
S13B     DFHMDF POS=(05,23),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLPMT   DFHMDF POS=(06,02),LENGTH=12,ATTRB=ASKIP,INITIAL='PMT AMOUNT..'
PMT      DFHMDF POS=(06,16),LENGTH=15,ATTRB=(UNPROT,FSET,NUM)
S13C     DFHMDF POS=(06,32),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLPRN   DFHMDF POS=(08,02),LENGTH=12,ATTRB=ASKIP,INITIAL='PRIN BAL....'
PRIN     DFHMDF POS=(08,16),LENGTH=15,ATTRB=ASKIP
LBLINT   DFHMDF POS=(09,02),LENGTH=12,ATTRB=ASKIP,INITIAL='INT ACCRUED.'
INTA     DFHMDF POS=(09,16),LENGTH=15,ATTRB=ASKIP
LBLESC   DFHMDF POS=(10,02),LENGTH=12,ATTRB=ASKIP,INITIAL='ESCROW......'
ESC      DFHMDF POS=(10,16),LENGTH=15,ATTRB=ASKIP
LBLLATE  DFHMDF POS=(11,02),LENGTH=12,ATTRB=ASKIP,INITIAL='LATE FEE....'
LATE     DFHMDF POS=(11,16),LENGTH=15,ATTRB=ASKIP
NOTE4    DFHMDF POS=(13,02),LENGTH=55,ATTRB=ASKIP,INITIAL='APPLY ORDER: LATE -> INT -> ESCROW -> PRINCIPAL'
MSG      DFHMDF POS=(22,01),LENGTH=78,ATTRB=(ASKIP,BRT)
FKEY     DFHMDF POS=(24,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='ENTER=PROCESS  PF3=END  PF9=OVERRIDE  CLEAR=CANCEL'
         DFHMSD TYPE=FINAL
         END
