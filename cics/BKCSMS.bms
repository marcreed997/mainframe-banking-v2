BKCSMS    DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,
               STORAGE=AUTO,TIOAPFX=YES,CTRL=(FREEKB,FRSET)
BKCSMSS   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
TTL      DFHMDF POS=(01,01),LENGTH=08,ATTRB=(ASKIP,BRT),
               INITIAL='BKCSMS'
TTL2     DFHMDF POS=(01,28),LENGTH=23,
               ATTRB=(ASKIP,BRT),INITIAL='CASH DEPOSIT / WITHDRAW'
LINE2    DFHMDF POS=(02,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='------------------------------------------------------------------------------'
LBLACC   DFHMDF POS=(04,02),LENGTH=12,ATTRB=ASKIP,INITIAL='ACCOUNT.....'
ACCNO    DFHMDF POS=(04,16),LENGTH=06,ATTRB=(UNPROT,IC,FSET)
S4A      DFHMDF POS=(04,23),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLNAM   DFHMDF POS=(05,02),LENGTH=12,ATTRB=ASKIP,INITIAL='NAME........'
CNAME    DFHMDF POS=(05,16),LENGTH=30,ATTRB=ASKIP
LBLBAL   DFHMDF POS=(06,02),LENGTH=12,ATTRB=ASKIP,INITIAL='LEDGER......'
BAL      DFHMDF POS=(06,16),LENGTH=15,ATTRB=ASKIP
LBLHLD   DFHMDF POS=(07,02),LENGTH=12,ATTRB=ASKIP,INITIAL='HOLDS.......'
HOLD     DFHMDF POS=(07,16),LENGTH=15,ATTRB=ASKIP
LBLAVL   DFHMDF POS=(08,02),LENGTH=12,ATTRB=ASKIP,INITIAL='AVAILABLE...'
AVAIL    DFHMDF POS=(08,16),LENGTH=15,ATTRB=ASKIP
LBLAMT   DFHMDF POS=(10,02),LENGTH=12,ATTRB=ASKIP,INITIAL='CASH AMT....'
AMT      DFHMDF POS=(10,16),LENGTH=15,ATTRB=(UNPROT,FSET,NUM)
S4B      DFHMDF POS=(10,32),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLSGN   DFHMDF POS=(11,02),LENGTH=12,ATTRB=ASKIP,INITIAL='D/C.........'
DRCR     DFHMDF POS=(11,16),LENGTH=01,ATTRB=(UNPROT,FSET),INITIAL='C'
S4C      DFHMDF POS=(11,18),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLCTR   DFHMDF POS=(13,02),LENGTH=40,ATTRB=ASKIP,INITIAL='CTR REQUIRED IF CASH >= 10000'
CTRFLG   DFHMDF POS=(14,02),LENGTH=12,ATTRB=ASKIP,INITIAL='CTR FLAG....'
CTR      DFHMDF POS=(14,16),LENGTH=01,ATTRB=ASKIP,INITIAL='N'
MSG      DFHMDF POS=(22,01),LENGTH=78,ATTRB=(ASKIP,BRT)
FKEY     DFHMDF POS=(24,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='ENTER=PROCESS  PF3=END  PF9=OVERRIDE  CLEAR=CANCEL'
         DFHMSD TYPE=FINAL
         END
