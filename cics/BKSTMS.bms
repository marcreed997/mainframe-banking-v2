BKSTMS    DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,
               STORAGE=AUTO,TIOAPFX=YES,CTRL=(FREEKB,FRSET)
BKSTMSS   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
TTL      DFHMDF POS=(01,01),LENGTH=08,ATTRB=(ASKIP,BRT),
               INITIAL='BKSTMS'
TTL2     DFHMDF POS=(01,28),LENGTH=23,
               ATTRB=(ASKIP,BRT),INITIAL='TELLER SIGN-ON / DRAWER'
LINE2    DFHMDF POS=(02,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='------------------------------------------------------------------------------'
LBLTID   DFHMDF POS=(04,02),LENGTH=12,ATTRB=ASKIP,INITIAL='TELLER ID...'
TLRID    DFHMDF POS=(04,16),LENGTH=08,ATTRB=(UNPROT,IC,FSET)
S6A      DFHMDF POS=(04,25),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLBR    DFHMDF POS=(05,02),LENGTH=12,ATTRB=ASKIP,INITIAL='BRANCH......'
BRNO     DFHMDF POS=(05,16),LENGTH=06,ATTRB=(UNPROT,FSET)
S6B      DFHMDF POS=(05,23),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLACT   DFHMDF POS=(06,02),LENGTH=12,ATTRB=ASKIP,INITIAL='ACTION......'
ACTN     DFHMDF POS=(06,16),LENGTH=01,ATTRB=(UNPROT,FSET),INITIAL='I'
S6C      DFHMDF POS=(06,18),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
HINT2    DFHMDF POS=(07,02),LENGTH=40,ATTRB=ASKIP,INITIAL='I=SIGNON  O=SIGNOFF  C=CASH COUNT'
LBLCSH   DFHMDF POS=(09,02),LENGTH=12,ATTRB=ASKIP,INITIAL='DRAWER CASH.'
CASH     DFHMDF POS=(09,16),LENGTH=15,ATTRB=(UNPROT,FSET,NUM)
S6D      DFHMDF POS=(09,32),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLLVL   DFHMDF POS=(10,02),LENGTH=12,ATTRB=ASKIP,INITIAL='OVERRIDE LV.'
OVR      DFHMDF POS=(10,16),LENGTH=01,ATTRB=ASKIP
LBLONL   DFHMDF POS=(12,02),LENGTH=20,ATTRB=ASKIP,INITIAL='ONLINE INHIBIT:'
INH      DFHMDF POS=(12,24),LENGTH=01,ATTRB=ASKIP
MSG      DFHMDF POS=(22,01),LENGTH=78,ATTRB=(ASKIP,BRT)
FKEY     DFHMDF POS=(24,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='ENTER=PROCESS  PF3=END  PF9=OVERRIDE  CLEAR=CANCEL'
         DFHMSD TYPE=FINAL
         END
