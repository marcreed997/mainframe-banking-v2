BKSWMS    DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,
               STORAGE=AUTO,TIOAPFX=YES,CTRL=(FREEKB,FRSET)
BKSWMSS   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
TTL      DFHMDF POS=(01,01),LENGTH=08,ATTRB=(ASKIP,BRT),
               INITIAL='BKSWMS'
TTL2     DFHMDF POS=(01,29),LENGTH=22,
               ATTRB=(ASKIP,BRT),INITIAL='SWEEP / ZBA ENROLLMENT'
LINE2    DFHMDF POS=(02,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='------------------------------------------------------------------------------'
LBLCH    DFHMDF POS=(04,02),LENGTH=12,ATTRB=ASKIP,INITIAL='CHILD ACCT..'
CHILD    DFHMDF POS=(04,16),LENGTH=06,ATTRB=(UNPROT,IC,FSET)
S12A     DFHMDF POS=(04,23),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLPA    DFHMDF POS=(05,02),LENGTH=12,ATTRB=ASKIP,INITIAL='PARENT ACCT.'
PARENT   DFHMDF POS=(05,16),LENGTH=06,ATTRB=(UNPROT,FSET)
S12B     DFHMDF POS=(05,23),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLTGT   DFHMDF POS=(06,02),LENGTH=12,ATTRB=ASKIP,INITIAL='TARGET BAL..'
TARGET   DFHMDF POS=(06,16),LENGTH=15,ATTRB=(UNPROT,FSET,NUM)
S12C     DFHMDF POS=(06,32),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLMIN   DFHMDF POS=(07,02),LENGTH=12,ATTRB=ASKIP,INITIAL='MIN SWEEP...'
MINSW    DFHMDF POS=(07,16),LENGTH=15,ATTRB=(UNPROT,FSET,NUM)
S12D     DFHMDF POS=(07,32),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLVEH   DFHMDF POS=(08,02),LENGTH=12,ATTRB=ASKIP,INITIAL='VEHICLE.....'
VEH      DFHMDF POS=(08,16),LENGTH=08,ATTRB=(UNPROT,FSET),INITIAL='MMDA    '
S12E     DFHMDF POS=(08,25),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
NOTE3    DFHMDF POS=(10,02),LENGTH=55,ATTRB=ASKIP,INITIAL='NIGHTLY BKZBA01 SWEEPS; PARENT NSF SKIPS CHILD COVER'
MSG      DFHMDF POS=(22,01),LENGTH=78,ATTRB=(ASKIP,BRT)
FKEY     DFHMDF POS=(24,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='ENTER=PROCESS  PF3=END  PF9=OVERRIDE  CLEAR=CANCEL'
         DFHMSD TYPE=FINAL
         END
