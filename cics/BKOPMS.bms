BKOPMS    DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,
               STORAGE=AUTO,TIOAPFX=YES,CTRL=(FREEKB,FRSET)
BKOPMSS   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
TTL      DFHMDF POS=(01,01),LENGTH=08,ATTRB=(ASKIP,BRT),
               INITIAL='BKOPMS'
TTL2     DFHMDF POS=(01,27),LENGTH=26,
               ATTRB=(ASKIP,BRT),INITIAL='OPERATIONS INHIBIT / CYCLE'
LINE2    DFHMDF POS=(02,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='------------------------------------------------------------------------------'
LBLCYC   DFHMDF POS=(04,02),LENGTH=12,ATTRB=ASKIP,INITIAL='CYCLE DATE..'
CYCLE    DFHMDF POS=(04,16),LENGTH=10,ATTRB=ASKIP
LBLSTS   DFHMDF POS=(05,02),LENGTH=12,ATTRB=ASKIP,INITIAL='STATUS......'
STS      DFHMDF POS=(05,16),LENGTH=08,ATTRB=ASKIP
LBLINH   DFHMDF POS=(06,02),LENGTH=12,ATTRB=ASKIP,INITIAL='INHIBIT.....'
INH      DFHMDF POS=(06,16),LENGTH=01,ATTRB=(UNPROT,FSET)
S14A     DFHMDF POS=(06,18),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLVAL   DFHMDF POS=(07,02),LENGTH=12,ATTRB=ASKIP,INITIAL='VALIDATED...'
VAL      DFHMDF POS=(07,16),LENGTH=01,ATTRB=ASKIP
LBLRCN   DFHMDF POS=(08,02),LENGTH=12,ATTRB=ASKIP,INITIAL='RECON CLOSE.'
RCN      DFHMDF POS=(08,16),LENGTH=01,ATTRB=ASKIP
LBLOWN   DFHMDF POS=(09,02),LENGTH=12,ATTRB=ASKIP,INITIAL='LOCK OWNER..'
OWNER    DFHMDF POS=(09,16),LENGTH=08,ATTRB=ASKIP
LBLACT   DFHMDF POS=(11,02),LENGTH=12,ATTRB=ASKIP,INITIAL='ACTION I/E..'
ACTN     DFHMDF POS=(11,16),LENGTH=01,ATTRB=(UNPROT,FSET)
S14B     DFHMDF POS=(11,18),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
NOTE5    DFHMDF POS=(13,02),LENGTH=60,ATTRB=ASKIP,INITIAL='I=INHIBIT (batch may post)  E=ENABLE (online resume)'
MSG      DFHMDF POS=(22,01),LENGTH=78,ATTRB=(ASKIP,BRT)
FKEY     DFHMDF POS=(24,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='ENTER=PROCESS  PF3=END  PF9=OVERRIDE  CLEAR=CANCEL'
         DFHMSD TYPE=FINAL
         END
