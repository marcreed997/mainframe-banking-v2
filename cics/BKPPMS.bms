BKPPMS    DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,
               STORAGE=AUTO,TIOAPFX=YES,CTRL=(FREEKB,FRSET)
BKPPMSS   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1,CTRL=(FREEKB,FRSET)
TTL      DFHMDF POS=(01,01),LENGTH=08,ATTRB=(ASKIP,BRT),
               INITIAL='BKPPMS'
TTL2     DFHMDF POS=(01,29),LENGTH=21,
               ATTRB=(ASKIP,BRT),INITIAL='POSITIVE PAY DECISION'
LINE2    DFHMDF POS=(02,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='------------------------------------------------------------------------------'
LBLACC   DFHMDF POS=(04,02),LENGTH=12,ATTRB=ASKIP,INITIAL='ACCOUNT.....'
ACCNO    DFHMDF POS=(04,16),LENGTH=06,ATTRB=(UNPROT,IC,FSET)
S10A     DFHMDF POS=(04,23),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLCK    DFHMDF POS=(05,02),LENGTH=12,ATTRB=ASKIP,INITIAL='SERIAL......'
SERIAL   DFHMDF POS=(05,16),LENGTH=10,ATTRB=(UNPROT,FSET,NUM)
S10B     DFHMDF POS=(05,27),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
LBLISS   DFHMDF POS=(06,02),LENGTH=12,ATTRB=ASKIP,INITIAL='ISSUED AMT..'
ISSAMT   DFHMDF POS=(06,16),LENGTH=15,ATTRB=ASKIP
LBLPRE   DFHMDF POS=(07,02),LENGTH=12,ATTRB=ASKIP,INITIAL='PRESENTED...'
PREAMT   DFHMDF POS=(07,16),LENGTH=15,ATTRB=ASKIP
LBLRSN   DFHMDF POS=(08,02),LENGTH=12,ATTRB=ASKIP,INITIAL='REASON......'
RSN      DFHMDF POS=(08,16),LENGTH=12,ATTRB=ASKIP
LBLDEC   DFHMDF POS=(10,02),LENGTH=12,ATTRB=ASKIP,INITIAL='P=PAY R=RET.'
DEC      DFHMDF POS=(10,16),LENGTH=01,ATTRB=(UNPROT,FSET),INITIAL='W'
S10C     DFHMDF POS=(10,18),LENGTH=01,ATTRB=ASKIP,INITIAL=' '
NOTE2    DFHMDF POS=(12,02),LENGTH=50,ATTRB=ASKIP,INITIAL='DUAL CONTROL REQUIRED ABOVE TELLER LIMIT'
MSG      DFHMDF POS=(22,01),LENGTH=78,ATTRB=(ASKIP,BRT)
FKEY     DFHMDF POS=(24,01),LENGTH=78,ATTRB=ASKIP,
               INITIAL='ENTER=PROCESS  PF3=END  PF9=OVERRIDE  CLEAR=CANCEL'
         DFHMSD TYPE=FINAL
         END
